        "content":  "\u003c!doctype html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"utf-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n  \u003ctitle\u003eExample Status\u003c/title\u003e\n  \u003cscript\u003e\n    (() =\u003e {\n      const tokenMap = { bg:\u0027--wash\u0027, surface:\u0027--paper\u0027, surfaceSoft:\u0027--panel\u0027, surfaceStrong:\u0027--surface-strong\u0027, text:\u0027--ink\u0027, muted:\u0027--muted\u0027, line:\u0027--line\u0027, lineStrong:\u0027--line-strong\u0027, accent:\u0027--accent\u0027, accentStrong:\u0027--accent-2\u0027, accentSoft:\u0027--accent-soft\u0027, activeText:\u0027--accent-ink\u0027, red:\u0027--danger\u0027, shadow:\u0027--shadow\u0027 }\n      const apply = context =\u003e {\n        if (!context || typeof context !== \u0027object\u0027) return\n        const theme = context.theme \u0026\u0026 typeof context.theme === \u0027object\u0027 ? context.theme : {}\n        Object.entries(tokenMap).forEach(([token, property]) =\u003e { if (theme[token]) document.documentElement.style.setProperty(property, theme[token]) })\n        const themeMode = String(context.themeMode || \u0027\u0027)\n        if (themeMode) {\n          document.documentElement.style.colorScheme = themeMode.toLowerCase().includes(\u0027dark\u0027) ? \u0027dark\u0027 : \u0027light\u0027\n          document.documentElement.dataset.theme = themeMode\n        }\n      }\n      try {\n        const params = new URLSearchParams(window.location.hash.replace(/^#/, \u0027\u0027))\n        const encoded = params.get(\u0027lf-runtime\u0027)\n        if (encoded) {\n          const context = JSON.parse(decodeURIComponent(encoded))\n          if (context?.type === \u0027lafenice:runtime-context:init\u0027) apply(context)\n        } else {\n          apply(JSON.parse(sessionStorage.getItem(\u0027lafenice:example-status:presentation\u0027) || \u0027null\u0027))\n        }\n      } catch {}\n    })()\n  \u003c/script\u003e\n  \u003cstyle\u003e\n    :root { color-scheme:light; --ink:#17211b; --muted:#657068; --line:#dce3dc; --line-strong:#aebbb1; --paper:#fff; --wash:#f3f6f3; --panel:#f8fbf9; --surface-strong:#e7ece7; --accent:#206b4b; --accent-2:#174e39; --accent-soft:#e5f2eb; --accent-ink:#fff; --danger:#a33b32; --shadow:0 22px 60px rgb(23 33 27 / .11); font-family:\"Segoe UI Variable Text\",\"Noto Sans TC\",\"Microsoft JhengHei\",Inter,ui-sans-serif,system-ui,sans-serif }\n    * { box-sizing:border-box }\n    body { min-height:100vh; margin:0; background-color:var(--wash); background-image:radial-gradient(circle at center,color-mix(in srgb,var(--accent) 30%,transparent) 0 1.25px,transparent 1.75px),linear-gradient(90deg,transparent 23px,color-mix(in srgb,var(--accent) 7%,transparent) 24px,transparent 25px),linear-gradient(0deg,transparent 23px,color-mix(in srgb,var(--accent) 7%,transparent) 24px,transparent 25px),radial-gradient(circle at 88% -15%,color-mix(in srgb,var(--accent) 20%,transparent),transparent 34%),radial-gradient(circle at -8% 78%,color-mix(in srgb,var(--accent) 10%,transparent),transparent 28%); background-position:-1px -1px,0 0,0 0,0 0,0 0; background-size:96px 96px,96px 96px,96px 96px,100% 100%,100% 100%; background-attachment:fixed; color:var(--ink); transition:background-color .25s ease,color .25s ease }\n    button { font:inherit; cursor:pointer }\n    button:disabled { cursor:wait; opacity:.55 }\n    .app { min-height:100vh; padding:clamp(18px,3vw,42px) }\n    .shell { max-width:1320px; margin:auto }\n    .hero,.panel { background:color-mix(in srgb,var(--paper) 96%,transparent); border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); backdrop-filter:blur(18px) }\n    .hero { position:relative; display:flex; align-items:end; justify-content:space-between; gap:24px; padding:30px 32px; margin-bottom:18px; overflow:hidden }\n    .hero::before { content:\"\"; position:absolute; inset:0 auto 0 0; width:4px; background:linear-gradient(var(--accent),color-mix(in srgb,var(--accent) 15%,transparent)); box-shadow:0 0 24px var(--accent) }\n    .eyebrow { margin:0 0 8px; color:var(--accent); font:800 .7rem/1.2 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.18em; text-transform:uppercase }\n    h1 { margin:0; max-width:900px; font-family:\"Segoe UI Variable Display\",\"Noto Sans TC\",\"Microsoft JhengHei\",ui-sans-serif,system-ui,sans-serif; font-size:clamp(2rem,4.6vw,3.7rem); font-weight:760; line-height:1.02; letter-spacing:-.045em; text-wrap:balance }\n    .subtitle { margin:10px 0 0; color:var(--muted) }\n    .actions { display:flex; align-items:center; gap:10px; flex-wrap:wrap }\n    .button { min-height:40px; border:1px solid var(--line); border-radius:8px; padding:0 15px; background:var(--paper); color:var(--ink); font-weight:750; transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease }\n    .button:hover:not(:disabled) { transform:translateY(-1px); border-color:var(--line-strong); background:var(--panel) }\n    .button.primary { border-color:var(--accent); background:var(--accent); color:var(--accent-ink); box-shadow:0 8px 22px color-mix(in srgb,var(--accent) 20%,transparent) }\n    .table-wrap { width:100%; min-height:180px; max-height:60dvh; overflow:auto; overscroll-behavior:contain; position:relative }\n    table { width:max-content; min-width:100%; border-collapse:separate; border-spacing:0 }\n    th,td { padding:13px 16px; border-bottom:1px solid var(--line); text-align:left; vertical-align:middle }\n    th { color:var(--muted); background:var(--panel); font:800 .73rem/1.2 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.07em; text-transform:uppercase; white-space:nowrap }\n    thead { position:sticky; top:0; z-index:2 }\n    .updated-column { width:220px; min-width:220px; padding-inline:10px; white-space:nowrap }\n    td.updated-column { font-variant-numeric:tabular-nums }\n    tbody tr { transition:background .16s ease }\n    tbody tr:hover { background:color-mix(in srgb,var(--accent-soft) 58%,transparent) }\n    .value { font-weight:700 }\n    .muted,.empty { color:var(--muted) }\n    .empty { padding:60px 22px; text-align:center }\n    .status { position:fixed; right:max(16px,env(safe-area-inset-right)); bottom:max(16px,env(safe-area-inset-bottom)); z-index:2147483647; width:max-content; max-width:min(460px,calc(100vw - 32px)); padding:13px 16px 13px 18px; border:1px solid color-mix(in srgb,var(--accent) 42%,var(--line)); border-left:4px solid var(--accent); border-radius:10px; box-shadow:var(--shadow); background:color-mix(in srgb,var(--paper) 96%,transparent); color:var(--ink); font-size:.9rem; font-weight:750; line-height:1.4; overflow-wrap:anywhere; pointer-events:none }\n    .status.error { border-color:color-mix(in srgb,var(--danger) 46%,var(--line)); border-left-color:var(--danger); background:color-mix(in srgb,var(--paper) 92%,var(--danger) 8%) }\n    .status[hidden] { display:none }\n    @media (max-width:720px) {\n      .app { padding:8px }\n      .hero { align-items:start; flex-direction:column; gap:18px; padding:20px 20px 18px; margin-bottom:10px }\n      .hero .actions { width:100% }\n      .hero .actions .button { flex:1 }\n      h1 { font-size:clamp(1.9rem,11vw,2.8rem) }\n      .table-wrap { max-height:62dvh }\n      .status { left:max(10px,env(safe-area-inset-left)); right:max(10px,env(safe-area-inset-right)); bottom:max(10px,env(safe-area-inset-bottom)); width:auto; max-width:none; padding:12px 14px }\n    }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cmain class=\"app\"\u003e\u003cdiv class=\"shell\"\u003e\n    \u003cheader class=\"hero\"\u003e\n      \u003cdiv\u003e\u003cp class=\"eyebrow\" id=\"eyebrow\"\u003eExample plugin\u003c/p\u003e\u003ch1 id=\"title\"\u003eExample System Status\u003c/h1\u003e\u003cp class=\"subtitle\" id=\"subtitle\"\u003eWaiting for App Shell context…\u003c/p\u003e\u003c/div\u003e\n      \u003cdiv class=\"actions\"\u003e\u003cbutton class=\"button primary\" id=\"refresh\" type=\"button\"\u003eRefresh\u003c/button\u003e\u003c/div\u003e\n    \u003c/header\u003e\n    \u003csection class=\"panel\" aria-live=\"polite\"\u003e\n      \u003cdiv class=\"table-wrap\"\u003e\u003ctable\u003e\u003cthead\u003e\u003ctr\u003e\u003cth id=\"propertyHeading\"\u003eProperty\u003c/th\u003e\u003cth id=\"valueHeading\"\u003eValue\u003c/th\u003e\u003cth id=\"updatedHeading\" class=\"updated-column\"\u003eUpdated at\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody id=\"statusRows\"\u003e\u003ctr\u003e\u003ctd class=\"empty\" colspan=\"3\"\u003eWaiting for App Shell context…\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\n    \u003c/section\u003e\n  \u003c/div\u003e\u003c/main\u003e\n  \u003cdiv class=\"status\" id=\"status\" hidden\u003e\u003c/div\u003e\n  \u003cscript\u003e\n    \u0027use strict\u0027\n\n    const state = { apiBaseUrl:\u0027\u0027, accessToken:\u0027\u0027, roles:[], locale:\u0027en-US\u0027, messages:{}, languagePack:{}, theme:{}, themeMode:\u0027light\u0027, loaded:false }\n    const els = { eyebrow:document.querySelector(\u0027#eyebrow\u0027), title:document.querySelector(\u0027#title\u0027), subtitle:document.querySelector(\u0027#subtitle\u0027), refresh:document.querySelector(\u0027#refresh\u0027), propertyHeading:document.querySelector(\u0027#propertyHeading\u0027), valueHeading:document.querySelector(\u0027#valueHeading\u0027), updatedHeading:document.querySelector(\u0027#updatedHeading\u0027), rows:document.querySelector(\u0027#statusRows\u0027), status:document.querySelector(\u0027#status\u0027) }\n\n    function localeField() {\n      const locale = String(state.locale || \u0027en-US\u0027)\n      if (locale.toLowerCase() === \u0027zh-tw\u0027) return \u0027name\u0027\n      return locale.replace(/-([a-zA-Z])/g, (_, letter) =\u003e letter.toUpperCase())\n    }\n\n    function languageText(key, fallback) {\n      const pack = state.languagePack?.items \u0026\u0026 typeof state.languagePack.items === \u0027object\u0027 ? state.languagePack.items : state.languagePack\n      const entry = pack?.[key] || {}\n      return entry[localeField()] || entry.enUS || entry.name || fallback\n    }\n\n    function fallbackText(key, fallback) {\n      const localized = languageText(key, \u0027\u0027)\n      if (localized) return localized\n      const copy = {\n        eyebrow:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027範例 plugin\u0027 : \u0027Example plugin\u0027,\n        title:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027範例系統狀態\u0027 : \u0027Example System Status\u0027,\n        refresh:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027重新整理\u0027 : \u0027Refresh\u0027,\n        property:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027屬性\u0027 : \u0027Property\u0027,\n        value:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027值\u0027 : \u0027Value\u0027,\n        updatedAt:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027更新時間\u0027 : \u0027Updated at\u0027,\n        loading:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027正在載入…\u0027 : \u0027Loading…\u0027,\n        waiting:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027等待 App Shell context…\u0027 : \u0027Waiting for App Shell context…\u0027,\n        healthy:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027健康\u0027 : \u0027Healthy\u0027,\n        authenticated:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027已驗證\u0027 : \u0027Authenticated\u0027,\n        anonymous:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027匿名\u0027 : \u0027Anonymous\u0027,\n        failed:state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027狀態讀取失敗\u0027 : \u0027Status load failed\u0027,\n      }\n      return copy[key] || fallback\n    }\n\n    function applyPresentationContext(context) {\n      if (!context || typeof context !== \u0027object\u0027) return\n      if (context.locale) state.locale = String(context.locale)\n      if (context.messages \u0026\u0026 typeof context.messages === \u0027object\u0027) state.messages = context.messages\n      if (context.languagePack \u0026\u0026 typeof context.languagePack === \u0027object\u0027) state.languagePack = context.languagePack\n      if (context.themeMode) state.themeMode = String(context.themeMode)\n      if (context.theme \u0026\u0026 typeof context.theme === \u0027object\u0027) state.theme = context.theme\n    }\n\n    function restoreInitialRuntimeContext() {\n      try {\n        const params = new URLSearchParams(window.location.hash.replace(/^#/, \u0027\u0027))\n        const encoded = params.get(\u0027lf-runtime\u0027)\n        if (encoded) applyPresentationContext(JSON.parse(decodeURIComponent(encoded)))\n        else applyPresentationContext(JSON.parse(sessionStorage.getItem(\u0027lafenice:example-status:presentation\u0027) || \u0027null\u0027))\n      } catch {}\n    }\n\n    function savePresentationContext() {\n      try { sessionStorage.setItem(\u0027lafenice:example-status:presentation\u0027, JSON.stringify({ locale:state.locale, messages:state.messages, languagePack:state.languagePack, themeMode:state.themeMode, theme:state.theme })) } catch {}\n    }\n\n    function applyTheme() {\n      const tokenMap = { bg:\u0027--wash\u0027, surface:\u0027--paper\u0027, surfaceSoft:\u0027--panel\u0027, surfaceStrong:\u0027--surface-strong\u0027, text:\u0027--ink\u0027, muted:\u0027--muted\u0027, line:\u0027--line\u0027, lineStrong:\u0027--line-strong\u0027, accent:\u0027--accent\u0027, accentStrong:\u0027--accent-2\u0027, accentSoft:\u0027--accent-soft\u0027, activeText:\u0027--accent-ink\u0027, red:\u0027--danger\u0027, shadow:\u0027--shadow\u0027 }\n      Object.entries(tokenMap).forEach(([token, property]) =\u003e { if (state.theme[token]) document.documentElement.style.setProperty(property, state.theme[token]) })\n      document.documentElement.style.colorScheme = state.themeMode.toLowerCase().includes(\u0027dark\u0027) ? \u0027dark\u0027 : \u0027light\u0027\n      document.documentElement.dataset.theme = state.themeMode\n    }\n\n    function renderCopy() {\n      document.documentElement.lang = state.locale.toLowerCase().startsWith(\u0027zh\u0027) ? \u0027zh-Hant\u0027 : state.locale\n      els.eyebrow.textContent = fallbackText(\u0027eyebrow\u0027, \u0027Example plugin\u0027)\n      els.title.textContent = languageText(\u0027lfxExampleStatus.title\u0027, fallbackText(\u0027title\u0027, \u0027Example System Status\u0027))\n      els.refresh.textContent = languageText(\u0027lfxExampleStatus.refresh\u0027, fallbackText(\u0027refresh\u0027, \u0027Refresh\u0027))\n      els.propertyHeading.textContent = fallbackText(\u0027property\u0027, \u0027Property\u0027)\n      els.valueHeading.textContent = fallbackText(\u0027value\u0027, \u0027Value\u0027)\n      els.updatedHeading.textContent = fallbackText(\u0027updatedAt\u0027, \u0027Updated at\u0027)\n      if (!state.loaded) els.subtitle.textContent = fallbackText(\u0027waiting\u0027, \u0027Waiting for App Shell context…\u0027)\n    }\n\n    function setStatus(message, isError = false) {\n      els.status.textContent = message\n      els.status.classList.toggle(\u0027error\u0027, isError)\n      els.status.hidden = !message\n    }\n\n    function renderRows(item) {\n      const updatedAt = item.updated_at_format || item.updated_at || \u0027—\u0027\n      const rows = [\n        [\u0027status\u0027, item.status || fallbackText(\u0027healthy\u0027, \u0027Healthy\u0027)],\n        [\u0027authenticated\u0027, item.authenticated ? fallbackText(\u0027authenticated\u0027, \u0027Authenticated\u0027) : fallbackText(\u0027anonymous\u0027, \u0027Anonymous\u0027)],\n        [\u0027plugin\u0027, item.plugin || \u0027—\u0027],\n      ]\n      const fragment = document.createDocumentFragment()\n      rows.forEach(([label, value]) =\u003e {\n        const row = document.createElement(\u0027tr\u0027)\n        const property = document.createElement(\u0027th\u0027); property.scope = \u0027row\u0027; property.textContent = label\n        const valueCell = document.createElement(\u0027td\u0027); valueCell.className = \u0027value\u0027; valueCell.textContent = String(value)\n        const updatedCell = document.createElement(\u0027td\u0027); updatedCell.className = \u0027updated-column\u0027; updatedCell.textContent = String(updatedAt)\n        row.append(property, valueCell, updatedCell); fragment.append(row)\n      })\n      els.rows.replaceChildren(fragment)\n    }\n\n    async function apiRequest(path, init = {}) {\n      const headers = { Accept:\u0027application/json\u0027, ...(init.body ? {\u0027Content-Type\u0027:\u0027application/json\u0027} : {}), ...(state.accessToken ? {Authorization:`Bearer ${state.accessToken}`} : {}) }\n      const response = await fetch(`${state.apiBaseUrl}/${String(path).replace(/^\\/+/, \u0027\u0027)}`, { ...init, headers:{ ...headers, ...init.headers } })\n      const text = await response.text()\n      let data = {}\n      try { data = text ? JSON.parse(text) : {} } catch {}\n      if (!response.ok) throw Object.assign(new Error(data.error?.message || data.detail || `Request failed (${response.status})`), { status:response.status, details:data.error || data })\n      return data\n    }\n\n    async function loadStatus() {\n      if (!state.apiBaseUrl) return\n      els.refresh.disabled = true\n      els.subtitle.textContent = fallbackText(\u0027loading\u0027, \u0027Loading…\u0027)\n      try {\n        const data = await apiRequest(\u0027lfx-example-status-api\u0027)\n        state.loaded = true\n        renderRows(data.item || {})\n        els.subtitle.textContent = languageText(\u0027lfxExampleStatus.healthy\u0027, fallbackText(\u0027healthy\u0027, \u0027Healthy\u0027))\n        setStatus(\u0027\u0027)\n      } catch (error) {\n        els.subtitle.textContent = fallbackText(\u0027failed\u0027, \u0027Status load failed\u0027)\n        const errorRow = document.createElement(\u0027tr\u0027)\n        const errorCell = document.createElement(\u0027td\u0027)\n        errorCell.className = \u0027empty\u0027; errorCell.colSpan = 3; errorCell.textContent = error.message\n        errorRow.append(errorCell)\n        els.rows.replaceChildren(errorRow)\n        setStatus(error.message, true)\n      } finally {\n        els.refresh.disabled = false\n      }\n    }\n\n    window.addEventListener(\u0027message\u0027, event =\u003e {\n      if (event.source !== window.parent || event.data?.type !== \u0027lafenice:runtime-context\u0027) return\n      const context = event.data\n      state.apiBaseUrl = String(context.apiBaseUrl || state.apiBaseUrl).replace(/\\/$/, \u0027\u0027)\n      state.accessToken = context.accessToken || \u0027\u0027\n      state.roles = Array.isArray(context.roles) ? context.roles.map(String) : []\n      applyPresentationContext(context)\n      savePresentationContext()\n      renderCopy()\n      applyTheme()\n      loadStatus()\n    })\n\n    restoreInitialRuntimeContext()\n    renderCopy()\n    applyTheme()\n    els.refresh.addEventListener(\u0027click\u0027, () =\u003e { loadStatus().catch(error =\u003e setStatus(error.message, true)) })\n    window.parent.postMessage({ type:\u0027lafenice:runtime-context:request\u0027 }, \u0027*\u0027)\n  \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n",
